DISCORD_CLIENT_ID=CHANGE_ME
DISCORD_GUILD_ID=CHANGE_ME
DISCORD_BOT_TOKEN=CHANGE_ME

# Dashboard OAuth settings. Add this redirect URI to your Discord application:
# For LAN access, add the server IP callback too, for example:
# http://192.168.1.10:3000/auth/callback
DISCORD_DASHBOARD_CLIENT_SECRET=CHANGE_ME
DISCORD_DASHBOARD_REDIRECT_URI=http://localhost:3000/auth/callback
DISCORD_DASHBOARD_PORT=3000

# Database settings
DATABASE_CONNECTION_STRING=sqlite:data/sudobotdb.sqlite
DATABASE_CONNECTION_STRING_A=postgres://admin:my-secret-dev-password@sudo-bot-db:5432/sudobotdb
DATABASE_CONNECTION_STRING_B=sqlite::memory:
DATABASE_LOG_LEVEL=debug
LOG_LEVEL=debug

# ID of the channel you want use with scrape-user-roles.js tool
DISCORD_SCRAPE_CHANNEL_ID=CHANGE_ME